# Dify Cloud应用API。密钥仅供FastAPI服务端读取，严禁使用VITE_前缀。
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_APP_API_KEY=
DIFY_WORKFLOW_VERSION=stage6-v1
DIFY_TIMEOUT_SECONDS=60
DIFY_RETRY_COUNT=2
DIFY_RETRY_BACKOFF_SECONDS=1
# false avoids broken proxy settings inherited by Python/PowerShell.
DIFY_TRUST_ENV_PROXY=false

# 模型标识用于审计展示。模型供应商和密钥在Dify Cloud控制台配置。
AI_MODEL_PROVIDER=tongyi
QWEN_MODEL_NAME=qwen-plus
DEEPSEEK_MODEL_NAME=deepseek-chat

# Dify调用本系统受控工具时使用。请替换为至少32位随机值。
AI_TOOL_TOKEN=

# cloudflared启动后产生的HTTPS地址，用于生成或更新Dify自定义工具配置。
PUBLIC_TOOL_BASE_URL=

# Feishu enterprise self-built app. Keep the App Secret on the server only.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Safe default: only listed open_ids may use business data.
# Format: open_id:role,open_id:role
# Roles: management, procurement, finance, production
FEISHU_ACCESS_MODE=allowlist
FEISHU_ALLOWED_USERS=
FEISHU_DEFAULT_ROLE=management

FEISHU_ALLOW_P2P=true
FEISHU_ALLOW_GROUP_AT=true
FEISHU_SEND_PROCESSING_MESSAGE=true
FEISHU_WORKER_COUNT=4
FEISHU_QUERY_TIMEOUT_SECONDS=90
FEISHU_MAX_REPLY_CHARS=12000
# false avoids broken proxy settings inherited by Python/PowerShell.
FEISHU_TRUST_ENV_PROXY=false
# card preserves Dify headings, lists and emphasis; text is the fallback.
FEISHU_REPLY_FORMAT=card
FEISHU_CARD_TEMPLATE=blue
FEISHU_MAX_CARD_BYTES=28000
FEISHU_SEND_RETRY_COUNT=3
FEISHU_SEND_RETRY_BACKOFF_SECONDS=1

LOCAL_ASSISTANT_API=http://127.0.0.1:8000/api/v1/assistant/query
LOCAL_ASSISTANT_HEALTH_API=http://127.0.0.1:8000/api/v1/health
LOCAL_IDENTITY_API=http://127.0.0.1:8000/api/v1/identities/feishu
LOCAL_FEISHU_FEEDBACK_API=http://127.0.0.1:8000/api/v1/notifications/feishu/callback
LOCAL_ASSISTANT_CONFIRM_API=http://127.0.0.1:8000/api/v1/assistant/confirm
FEISHU_STATE_DATABASE=data/feishu_channel.sqlite3
